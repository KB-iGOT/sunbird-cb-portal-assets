{
    "trasformContentJson": [
        {
            "operation": "shift",
            "spec": {
                "Name": "content.name",
                "Description": "content.description",
                "Duration": "content.duration",
                "Link": "content.redirectUrl",
                "Image Url": "content.appIcon",
                "Code": "content.externalId",
                "Objectives": "content.objectives",
                "Topic": "content.topic"
            }
        }
    ],
    "transformProgressJson": [  
        {    
            "operation": "shift",    
            "spec": {
                "Student Id": "userid",      
                "Id": "courseid",      
                "Completion Date": "completedon"    
            } 
        }],
    "certificateTemplateUrl": "",
    "transformContentViaApi": [            
        {
            "spec": {
                "paging": {
                    "total": "count"
                },
                "elements": {
                    "*": {
                        "email": "data[&1].userid",
                        "contentId": "data[&1].courseid",
                        "completedAt": "data[&1].completedon",
                        "contentType": "data[&1].contentType",
                        "isCompleted": "data[&1].isCompleted"
                    }
                }
            },
            "operation": "shift"
        },
        {
            "spec": {
                "data": {
                    "*": {
                        "isCompleted": true
                    }
                }
            },
            "operation": "modify-overwrite-beta"
        }
    ]
}