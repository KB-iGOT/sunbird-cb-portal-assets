{
    "trasformContentJson": [
        {
            "operation": "shift",
            "spec": {
                "Course Name": "content.name",
                "Course Description": "content.description",
                "Course Duration": "content.duration",
                "Course Link": "content.redirectUrl",
                "Course Thumbnail": "content.appIcon",
                "Course Id": "content.externalId",
                "Course Objective": "content.objectives",
                "Course Topic": "content.topic",
                "Course Summary": "content.summary",
                "Course Difficulty Level": "content.difficultyLevel",
                "Course Providers": "content.courseProvider"
            },
            "requiredList": [
              "Course Name", 
              "Course Description", 
              "Course Duration", 
              "Course Link", 
              "Course Thumbnail", 
              "Course Id", 
              "Course Objective", 
              "Course Topic"
            ]
        }
    ],
    "transformProgressJson": [  
        {    
            "operation": "shift",    
            "spec": {
                "User Id": "userid",      
                "Course Id": "courseid",      
                "Completion Date": "completedon"    
            } 
        }],
    "certificateTemplateUrl": "",
    "transformContentViaApi": [
        {
          "spec": {
            "paging": {
              "total": "totalCount"
            },
            "elements": {
              "*": {
                "name": "data[&1].name",
                "programs": {
                  "*": {
                    "contentUrl": "data[&3].redirectUrl"
                  }
                },
                "contentId": "data[&1].externalId",
                "description": "data[&1].description",
                "extraMetadata": {
                  "definition": {
                    "tagline": "data[&3].topic",
                    "promoPhoto": "data[&3].appIcon"
                  }
                }
              }
            }
          },
          "operation": "shift"
        },
        {
          "spec": {
            "data": {
              "*": {
                "redirectUrl": "=concat('https://www.coursera.org/programs/learning-program-4spdd?productId=', @(1,externalId), '&productType=Specialization&showMiniModal=true&attemptSSOLogin=true')"
              }
            }
          },
          "operation": "modify-overwrite-beta"
        }
      ],

    "configureCertificateGuide": {
      "helpCenterGuide": {
        "header": "Content Upload Details: Video Guides and Tips",
        "guideNotes": [
          "Upload the certificate using a SVG file."
        ],
        "helpVideoLink": "/assets/public/content/guide-videos/CIOS_Updated_demo.mp4"
      },
      "instructions": [
        "Please ensure the Certificate file is named correctly"
      ]
    },
   "bulkUploadCourse" : {
    "instructions" : ["Please ensure the course catalog file is named correctly and data is accurate.", "Download the log report from 'Download Log' for details on the uploaded file."],
    "sampleFileDownloadLink": "/assets/samplefiles/sampleDataCourseOnboarding.csv"
   },
   "SSO_attributs": [
    "uuid",
    "uuid@karmayogi.com",
    "userFullName"
   ]
}