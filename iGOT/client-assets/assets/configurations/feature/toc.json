  "learnerAdvisory": [
    {
      "id": 1,
      "content": "Watch content at a speed that ensures understanding and retention.",
      "contentImg": "assets/icons/learner-advisory/watch-speed.png"
    },
    {
      "id": 2,
      "content": "Avoid fast-forwarding and speeding through.",
