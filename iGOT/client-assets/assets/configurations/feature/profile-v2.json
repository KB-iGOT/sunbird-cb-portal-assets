                    "placeholder": "",
                    "valuePath": "pinCode",
                    "maxLength": 6,
                    "pattern": "^[0-9]{6}$",
                    "row": "categoryPinRow",
                    "errorMessages": {
                        "pattern": "Please enter a valid 6-digit pin code."
                    },
                    "required": false,
                    "disabled": false
                },
                {
                    "type": "mobile",
                    "key": "mobile",
                    "label": "NetworkV2Profile.mobileNumber",
                    "placeholder": "Enter Mobile Number",
                    "valuePath": "mobile",
                    "prefix": "+91",
