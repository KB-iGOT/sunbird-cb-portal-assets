        "serviceHistoryEdit": {
            "isDynamicDialog": true,
            "fields": [{
                "type": "organisation-select",
                "key": "orgName",
                "label": "Organisation",
                "placeholder": "Select Organisation/Ministry",
                "searchPlaceholder": "Search Organisation/Ministry",
                "required": true,
                "valuePath": "orgName",
                "canUpdate": false,
                "errorMessages": {
                    "required": "Please select an organisation."
                }
            }, {
                "type": "designation-select",
                "key": "designation",
                "label": "Designation",
                "placeholder": "Select Designation",
                "searchPlaceholder": "Search Designation",
                "required": true,
                "valuePath": "designation",
                "canUpdate": false,
                "dependencyField": "orgName",
                "errorMessages": {
                    "required": "Please select a designation."
                }
            }, {
                "type": "select",
                "key": "orgState",
                "label": "State",
                "placeholder": "Select State",
                "valuePath": "orgState",
                "row": "stateDistrictRow",
                "optionsSource": "states"
            },
                {
                "type": "select",
                "key": "orgDistrict",
                "label": "District",
                "placeholder": "Select District",
                "valuePath": "orgDistrict",
                "row": "stateDistrictRow",
                "optionsSource": "districts",
                "dependencyField": "orgState"
                },
                {
                "type": "date",
                "key": "startDate",
                "label": "Start Date",
                "placeholder": "Select Date",
                "valuePath": "startDate",
                "row": "dateRow"
                },
                {
                "type": "date",
                "key": "endDate",
                "label": "End Date",
                "placeholder": "Select Date",
                "valuePath": "endDate",
                "row": "dateRow",
                "disableDependency": {
                        "key": "currentlyWorking",
                        "value": true
                    }
                },
                {
                "type": "checkbox",
                "key": "currentlyWorking",
                "label": "Currently Working",
                "defaultValue": false,
                "valuePath": "currentlyWorking"
                },
                {
                "type": "textarea",
                "key": "description",
                "label": "Description",
                "placeholder": "Add your description",
                "maxLength": 1000,
                "valuePath": "description"
                }
            ]
        },
        "educationalQualificationsEdit": {
            "isDynamicDialog": true,
            "fields": [
                {
                "type": "degree-select",
                "key": "degree",
                "label": "Degree",
                "placeholder": "Select Degree",
                "required": true,
                "valuePath": "degree",
                "searchPlaceholder": "Search degree...",
                "row": "row1"
                },
                {
                "type": "text",
                "key": "otherDegree",
                "label": "Other Degree",
                "placeholder": "Enter your degree",
                "maxLength": 80,
                "pattern": "^[a-zA-Z0-9\\s(),.&/]*$",
                "conditionalOn": {
                    "key": "degree",
                    "value": "Other",
                    "operator": "==="
                },
                "row": "row1"
                },
                {
                "type": "text",
                "key": "fieldOfStudy",
                "label": "Field of Study",
                "placeholder": "Enter your specialization(e.g., IT, Civil)",
                "required": true,
                "maxLength": 250,
                "pattern": "^[a-zA-Z0-9\\s.,'-]*$",
                "row": "row2"
                },
                {
                "type": "institution-select",
                "key": "institutionName",
                "label": "Institute Name",
                "placeholder": "Please select an institute name",
                "required": true,
                "valuePath": "institutionName",
                "searchPlaceholder": "Search institute...",
                "row": "row3"
                },
                {
                "type": "text",
                "key": "otherInstituteName",
                "label": "Other Institute Name",
                "placeholder": "Enter institute name",
                "maxLength": 125,
                "pattern": "^[a-zA-Z0-9\\s(),.&/]*$",
                "conditionalOn": {
                    "key": "institutionName",
                    "value": "Other",
                    "operator": "==="
                },
                "row": "row3"
                },
                {
                "type": "year-select",
                "key": "startYear",
                "label": "Start Year",
                "placeholder": "Select Year",
                "required": true,
                "valuePath": "startYear",
                "yearFrom": 1900,
                "row": "row4"
                },
                {
                "type": "year-select",
                "key": "endYear",
                "label": "End Year",
                "placeholder": "Select Year",
                "required": true,
                "valuePath": "endYear",
                "yearFrom": 1900,
                "row": "row4"
                }
            ]
        },
        "achievementsEdit": {
            "isDynamicDialog": true,
            "fields": [
                {
                    "type": "info-text",
                    "key": "_note",
                    "text": "Added achievements will be reflected in the Learner Passbook after 30 minutes"
                },
                {
                    "type": "text",
                    "key": "title",
                    "label": "Title",
                    "placeholder": "e.g. Excel beginner",
                    "required": true,
                    "maxLength": 70,
                    "minLength": 10,
                    "valuePath": "contextData.title",
                    "errorMessages": {
                        "required": "Please enter a title.",
                        "minlength": "Title must be at least 10 characters.",
                        "maxlength": "Title cannot exceed 70 characters.",
                        "pattern": "Allowed characters: letters, numbers and .,_-$/:[]()\\'  !&"
                    }
                },
                {
                    "type": "text",
                    "key": "issuedOrganisation",
                    "label": "Issuing Organisation",
                    "placeholder": "e.g. Microsoft",
                    "required": true,
                    "maxLength": 70,
                    "valuePath": "contextData.issuedOrganisation",
                    "errorMessages": {
                        "required": "Issuing organisation is required.",
                        "maxlength": "Issuing organisation cannot exceed 70 characters."
                    }
                },
                {
                    "type": "date",
                    "key": "startDate",
                    "label": "Start Date",
                    "placeholder": "Start Date",
                    "valuePath": "contextData.startDate",
                    "maxDate": "new Date()",
                    "readonly": true,
                    "row": "achievementDateRow"
                },
                {
                    "type": "date",
                    "key": "endDate",
                    "label": "End Date",
                    "placeholder": "Select Date",
                    "valuePath": "contextData.endDate",
                    "maxDate": "new Date()",
                    "readonly": true,
                    "row": "achievementDateRow"
                },
                {
                    "type": "date",
                    "key": "issuedDate",
                    "label": "Issue Date",
                    "placeholder": "Select Date",
                    "required": true,
                    "valuePath": "contextData.issuedDate",
                    "maxDate": "new Date()",
                    "readonly": true,
                    "row": "issuedTrainingRow",
                    "errorMessages": {
                        "required": "Please select an issue date."
                    }
                },
                {
                    "type": "select",
                    "key": "trainingType",
                    "label": "Training Type",
                    "placeholder": "Select training type",
                    "required": true,
                    "valuePath": "contextData.trainingType",
                    "row": "issuedTrainingRow",
                    "options": [
                        {
                            "label": "Domestic Training",
                            "value": "Domestic Training"
                        },
                        {
                            "label": "Foreign Training",
                            "value": "Foreign Training"
                        },
                        {
                            "label": "In Service Training",
                            "value": "In Service Training"
                        },
                        {
                            "label": "Mid-Career Training",
                            "value": "Mid-Career Training"
                        },
                        {
                            "label": "Other Training",
                            "value": "Other Training"
                        }
                    ],
                    "errorMessages": {
                        "required": "Training type is required."
                    }
                },
                {
                    "type": "select",
                    "key": "deliveryMode",
                    "label": "Delivery mode",
                    "placeholder": "Select delivery mode",
                    "valuePath": "contextData.deliveryMode",
                    "row": "deliveryLearningRow",
                    "options": [
                        {
                            "label": "Online",
                            "value": "Online"
                        },
                        {
                            "label": "Offline",
                            "value": "Offline"
                        },
                        {
                            "label": "Hybrid",
                            "value": "Hybrid"
                        }
                    ]
                },
                {
                    "type": "duration",
                    "key": "learningTime",
                    "label": "Learning Hours (hh:mm)",
                    "valuePath": "contextData.learningTime",
                    "row": "deliveryLearningRow"
                },
                {
                    "type": "image",
                    "key": "uploadedDocument",
                    "label": "Upload",
                    "required": true,
                    "infoText": "PNG, JPG, JPEG and PDF files are supported (maximum size: 5MB).",
                    "accept": ".png,.jpg,.jpeg,.pdf",
                    "maxSizeMB": 5,
                    "valuePath": "contextData.documentUrl"
                },
                {
                    "type": "url",
                    "key": "url",
                    "label": "URL",
                    "placeholder": "e.g. https://www.example.com",
                    "required": true,
                    "infoText": "You may provide the link for the achievement.",
                    "valuePath": "contextData.url",
                    "errorMessages": {
                        "required": "URL is required.",
                        "pattern": "Please enter a valid URL."
                    }
                },
                {
                    "type": "textarea",
                    "key": "description",
                    "label": "Learning Objective",
                    "placeholder": "Describe about the skills that you have gained from this learning",
                    "maxLength": 500,
                    "valuePath": "contextData.description"
                }
            ]
        }
    }
}